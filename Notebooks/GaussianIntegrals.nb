Notebook[{Cell["Gaussian membership function", "Title"], 
  Cell["mu = center Mu; sigma = Sigma > 0; h = UMax. First derive the support \
endpoints. Each moment then shows (1) an antiderivative derived by Integrate, \
(2) its parts, and (3) the computed definite moment F(x1)-F(x0). Evaluate \
from top to bottom. The current library uses mu +/- 4*sigma; the endpoint \
section derives the corresponding tail fraction.", "Text"], 
  Cell["Setup", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"mu", ",", "sigma", ",", "h", ",", "x", ",", "z", ",", "x0", 
          ",", "x1", ",", "gaussian", ",", "assumptions", ",", 
          "zAssumptions", ",", "toShorthand", ",", "partDefinitions", ",", 
          "inputX", ",", "transformed", ",", "primitiveZ", ",", "raw", ",", 
          "short", ",", "parts", ",", "formula", ",", "g", ",", "e", ",", 
          "e2", ",", "e3"}], "]"}], ";", 
      RowBox[{RowBox[{"gaussian", "[", "t_", "]"}], ":=", 
        RowBox[{"h", " ", RowBox[{"Exp", "[", RowBox[
             {"-", FractionBox[SuperscriptBox[RowBox[{"(", RowBox[{"t", "-", 
                    "mu"}], ")"}], "2"], RowBox[{"2", " ", SuperscriptBox[
                  "sigma", "2"]}]]}], "]"}]}]}], ";", 
      RowBox[{"assumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"mu", ",", "sigma", ",", "h", ",", 
                "x", ",", "x0", ",", "x1"}], "}"}], "\[Element]", 
            TemplateBox[{}, "Reals"]}], "&&", RowBox[{"sigma", ">", "0"}], 
          "&&", RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"x0", "<", "x1"}]}]}], ";", 
      RowBox[{"zAssumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"mu", ",", "sigma", ",", "h", ",", 
                "z"}], "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
          RowBox[{"sigma", ">", "0"}], "&&", RowBox[{"0", "<", "h", 
            "\[LessEqual]", "1"}]}]}], ";", 
      RowBox[{RowBox[{"toShorthand", "[", "expression_", "]"}], ":=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{RowBox[{"expression", "/.", "\[VeryThinSpace]", 
                RowBox[{"{", RowBox[{RowBox[{RowBox[{"Exp", "[", RowBox[
                         {"-", FractionBox[SuperscriptBox["z", "2"], "2"]}], 
                        "]"}], "\[Rule]", RowBox[{"g", "[", "x", "]"}]}], 
                    ",", RowBox[{RowBox[{"Exp", "[", RowBox[{"-", 
                          SuperscriptBox["z", "2"]}], "]"}], "\[Rule]", 
                      SuperscriptBox[RowBox[{"g", "[", "x", "]"}], "2"]}], 
                    ",", RowBox[{RowBox[{"Erf", "[", FractionBox["z", 
                         SqrtBox["2"]], "]"}], "\[Rule]", RowBox[{"e", "[", 
                        "x", "]"}]}], ",", RowBox[{RowBox[{"Erf", "[", "z", 
                        "]"}], "\[Rule]", RowBox[{"e2", "[", "x", "]"}]}], 
                    ",", RowBox[{RowBox[{"Erf", "[", RowBox[{SqrtBox[
                          FractionBox["3", "2"]], " ", "z"}], "]"}], 
                      "\[Rule]", RowBox[{"e3", "[", "x", "]"}]}]}], "}"}]}], 
              "/.", "\[VeryThinSpace]", RowBox[{"z", "\[Rule]", FractionBox[
                 RowBox[{"x", "-", "mu"}], "sigma"]}]}], ",", 
            "assumptions"}], "]"}]}], ";", RowBox[{"partDefinitions", "=", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{RowBox[{"g", "[", "x", "]"}], "\[Rule]", RowBox[{"Exp", 
                "[", RowBox[{"-", FractionBox[SuperscriptBox[RowBox[
                     {"(", RowBox[{"x", "-", "mu"}], ")"}], "2"], 
                   RowBox[{"2", " ", SuperscriptBox["sigma", "2"]}]]}], 
                "]"}]}], ",", RowBox[{RowBox[{"e", "[", "x", "]"}], 
              "\[Rule]", RowBox[{"Erf", "[", FractionBox[RowBox[{"x", "-", 
                   "mu"}], RowBox[{SqrtBox["2"], " ", "sigma"}]], "]"}]}], 
            ",", RowBox[{RowBox[{"e2", "[", "x", "]"}], "\[Rule]", 
              RowBox[{"Erf", "[", FractionBox[RowBox[{"x", "-", "mu"}], 
                 "sigma"], "]"}]}], ",", RowBox[{RowBox[{"e3", "[", "x", 
                "]"}], "\[Rule]", RowBox[{"Erf", "[", FractionBox[
                 RowBox[{SqrtBox[FractionBox["3", "2"]], " ", RowBox[
                    {"(", RowBox[{"x", "-", "mu"}], ")"}]}], "sigma"], 
                "]"}]}]}], "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"Gaussian\"", "\[Rule]", RowBox[{"gaussian", "[", 
              "x", "]"}]}], ",", RowBox[{"\"Assumptions\"", "\[Rule]", 
            "assumptions"}]}], "]"}]}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Gaussian\"", "\[Rule]", 
          RowBox[{SuperscriptBox["\[ExponentialE]", RowBox[{"-", FractionBox[
                SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{"-", "mu"}], "+", 
                     "x"}], ")"}], "2"], RowBox[{"2", " ", SuperscriptBox[
                   "sigma", "2"]}]]}]], " ", "h"}]}], ",", 
        RowBox[{"\"Assumptions\"", "\[Rule]", 
          RowBox[{RowBox[{RowBox[{"(", RowBox[{"mu", "|", "sigma", "|", "h", 
                  "|", "x", "|", "x0", "|", "x1"}], ")"}], "\[Element]", 
              TemplateBox[{}, "Reals"]}], "&&", RowBox[{"sigma", ">", "0"}], 
            "&&", RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
            RowBox[{"x0", "<", "x1"}]}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], Cell["Gaussian endpoints", "Section"], 
  Cell["1. Solve for the distance from the center", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"d", ",", "q", ",", "endpointAssumptions", ",", 
          "distanceSolution", ",", "distance", ",", "endpoints", ",", 
          "libraryTailSolution"}], "]"}], ";", 
      RowBox[{"endpointAssumptions", "=", 
        RowBox[{RowBox[{RowBox[{"{", RowBox[{"h", ",", "sigma", ",", "q", 
                ",", "d"}], "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], 
          "&&", RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"sigma", ">", "0"}], "&&", RowBox[{"0", "<", "q", "<", 
            "1"}]}]}], ";", RowBox[{"distanceSolution", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{RowBox[{"h", " ", 
                      RowBox[{"Exp", "[", RowBox[{"-", FractionBox[
                          SuperscriptBox["d", "2"], RowBox[{"2", " ", 
                          SuperscriptBox["sigma", "2"]}]]}], "]"}]}], 
                    "\[Equal]", RowBox[{"h", " ", "q"}]}], "&&", 
                  RowBox[{"d", ">", "0"}]}], ",", "d", ",", TemplateBox[{}, 
                 "Reals"], ",", RowBox[{"Assumptions", "\[Rule]", 
                  "endpointAssumptions"}]}], "]"}], ",", 
            "endpointAssumptions"}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
            TagBox[RowBox[{RowBox[{"h", " ", RowBox[{"Exp", "[", RowBox[
                    {"-", FractionBox[SuperscriptBox["d", "2"], RowBox[
                       {"2", " ", SuperscriptBox["sigma", "2"]}]]}], "]"}]}], 
               "\[Equal]", RowBox[{"h", " ", "q"}]}], HoldForm]}], ",", 
          RowBox[{"\"Distance solutions\"", "\[Rule]", 
            "distanceSolution"}]}], "]"}]}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
          TagBox[RowBox[{RowBox[{"h", " ", RowBox[{"Exp", "[", RowBox[
                  {"-", FractionBox[SuperscriptBox["d", "2"], RowBox[
                     {"2", " ", SuperscriptBox["sigma", "2"]}]]}], "]"}]}], 
             "\[Equal]", RowBox[{"h", " ", "q"}]}], HoldForm]}], ",", 
        RowBox[{"\"Distance solutions\"", "\[Rule]", 
          RowBox[{"{", RowBox[{"{", RowBox[{"d", "\[Rule]", RowBox[
                 {"sigma", " ", SqrtBox[RowBox[{"Log", "[", FractionBox["1", 
                      SuperscriptBox["q", "2"]], "]"}]]}]}], "}"}], 
            "}"}]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], 
  Cell["2. Apply the distance on both sides of the center", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"distance", "=", 
        RowBox[{"d", "/.", "\[VeryThinSpace]", RowBox[{"First", "[", 
            "distanceSolution", "]"}]}]}], ";", 
      RowBox[{"endpoints", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[
                   {"mu", "-", "distance"}]}], ",", RowBox[{"x1", "\[Rule]", 
                  RowBox[{"mu", "+", "distance"}]}]}], "}"}], ",", 
            RowBox[{"assumptions", "&&", RowBox[{"q", "\[Element]", 
                TemplateBox[{}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                "1"}]}]}], "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", "distance"}], 
          ",", RowBox[{"\"Endpoints\"", "\[Rule]", "endpoints"}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", 
          RowBox[{"sigma", " ", SqrtBox[RowBox[{"Log", "[", FractionBox["1", 
                SuperscriptBox["q", "2"]], "]"}]]}]}], ",", 
        RowBox[{"\"Endpoints\"", "\[Rule]", RowBox[
           {"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"mu", "-", 
                  RowBox[{"sigma", " ", SqrtBox[RowBox[{"Log", "[", 
                       FractionBox["1", SuperscriptBox["q", "2"]], 
                       "]"}]]}]}]}], ",", RowBox[{"x1", "\[Rule]", 
                RowBox[{"mu", "+", RowBox[{"sigma", " ", SqrtBox[RowBox[
                      {"Log", "[", FractionBox["1", SuperscriptBox["q", 
                         "2"]], "]"}]]}]}]}]}], "}"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Endpoint memberships and the library's four-sigma bounds", 
   "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"libraryTailSolution", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{"h", " ", 
                    RowBox[{"Exp", "[", RowBox[{"-", FractionBox[
                         SuperscriptBox[RowBox[{"(", RowBox[{"4", " ", 
                          "sigma"}], ")"}], "2"], RowBox[{"2", " ", 
                          SuperscriptBox["sigma", "2"]}]]}], "]"}]}], 
                  "\[Equal]", RowBox[{"h", " ", "q"}]}], ",", "q", ",", 
                TemplateBox[{}, "Reals"], ",", RowBox[{"Assumptions", 
                  "\[Rule]", "endpointAssumptions"}]}], "]"}], ",", 
            "endpointAssumptions"}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[
         {RowBox[{"\"Memberships {left, right}\"", "\[Rule]", 
            RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"{", 
                    RowBox[{RowBox[{"gaussian", "[", "x0", "]"}], ",", 
                      RowBox[{"gaussian", "[", "x1", "]"}]}], "}"}], "/.", 
                  "\[VeryThinSpace]", "endpoints"}], ",", RowBox[
                 {"assumptions", "&&", RowBox[{"q", "\[Element]", TemplateBox[
                     {}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                    "1"}]}]}], "]"}]}], ",", 
          RowBox[{"\"Tail fraction at four sigma\"", "\[Rule]", 
            "libraryTailSolution"}], ",", RowBox[
           {"\"Current library endpoints\"", "\[Rule]", 
            RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"endpoints", "/.", 
                  "\[VeryThinSpace]", RowBox[{"First", "[", 
                    "libraryTailSolution", "]"}]}], ",", "assumptions"}], 
              "]"}]}]}], "]"}]}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Memberships {left, right}\"", "\[Rule]", 
          RowBox[{"{", RowBox[{RowBox[{"h", " ", "q"}], ",", RowBox[{"h", 
                " ", "q"}]}], "}"}]}], ",", 
        RowBox[{"\"Tail fraction at four sigma\"", "\[Rule]", 
          RowBox[{"{", RowBox[{"{", RowBox[{"q", "\[Rule]", FractionBox["1", 
                 SuperscriptBox["\[ExponentialE]", "8"]]}], "}"}], "}"}]}], 
        ",", RowBox[{"\"Current library endpoints\"", "\[Rule]", 
          RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"mu", "-", 
                  RowBox[{"4", " ", "sigma"}]}]}], ",", RowBox[{"x1", 
                "\[Rule]", RowBox[{"mu", "+", RowBox[{"4", " ", 
                    "sigma"}]}]}]}], "}"}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], Cell["Area", "Section"], 
  Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "primitiveZ", ",", "raw", 
          ",", "short", ",", "parts", ",", "formula", ",", "g", ",", "e", 
          ",", "e2", ",", "e3"}], "]"}], ";", 
      RowBox[{"inputX", "=", RowBox[{"gaussian", "[", "x", "]"}]}], ";", 
      RowBox[{"transformed", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"sigma", " ", RowBox[{"(", RowBox[{"inputX", "/.", 
                  "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", RowBox[
                     {"mu", "+", RowBox[{"sigma", " ", "z"}]}]}]}], ")"}]}], 
            ",", "zAssumptions"}], "]"}]}], ";", 
      RowBox[{"primitiveZ", "=", RowBox[{"Integrate", "[", 
          RowBox[{"transformed", ",", "z", ",", RowBox[{"Assumptions", 
              "\[Rule]", "zAssumptions"}]}], "]"}]}], ";", 
      RowBox[{"raw", "=", RowBox[{"Association", "[", 
          RowBox[{"\"Area\"", "\[Rule]", RowBox[{"Collect", "[", 
              RowBox[{RowBox[{"Expand", "[", RowBox[{"FullSimplify", "[", 
                    RowBox[{RowBox[{"primitiveZ", "/.", "\[VeryThinSpace]", 
                        RowBox[{"z", "\[Rule]", FractionBox[RowBox[{"x", "-", 
                          "mu"}], "sigma"]}]}], ",", "assumptions"}], "]"}], 
                  "]"}], ",", "_Erf", ",", "Factor"}], "]"}]}], "]"}]}], ";", 
      "raw"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", RowBox[{"h", " ", 
          SqrtBox[FractionBox["\[Pi]", "2"]], " ", "sigma", " ", 
          RowBox[{"Erf", "[", FractionBox[RowBox[{RowBox[{"-", "mu"}], "+", 
               "x"}], RowBox[{SqrtBox["2"], " ", "sigma"}]], "]"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"short", "=", RowBox[{"toShorthand", "[", 
          "primitiveZ", "]"}]}], ";", RowBox[{"parts", "=", 
        RowBox[{"KeySelect", "[", RowBox[{"partDefinitions", ",", 
            RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"short", ",", 
                    "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", "parts"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"e", "[", "x", "]"}], "\[Rule]", 
        RowBox[{"Erf", "[", FractionBox[RowBox[{RowBox[{"-", "mu"}], "+", 
             "x"}], RowBox[{SqrtBox["2"], " ", "sigma"}]], "]"}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Compute the compact definite moment", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"formula", "=", 
        RowBox[{"Association", "[", RowBox[{"\"Area\"", "\[Rule]", 
            RowBox[{"Factor", "[", RowBox[{RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x1"}]}], ")"}], "-", RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x0"}]}], ")"}]}], "]"}]}], "]"}]}], ";", "formula"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", RowBox[{RowBox[{"-", "h"}], " ", 
          SqrtBox[FractionBox["\[Pi]", "2"]], " ", "sigma", " ", 
          RowBox[{"(", RowBox[{RowBox[{"e", "[", "x0", "]"}], "-", 
              RowBox[{"e", "[", "x1", "]"}]}], ")"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["MomentX", "Section"], Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "primitiveZ", ",", "raw", 
          ",", "short", ",", "parts", ",", "formula", ",", "g", ",", "e", 
          ",", "e2", ",", "e3"}], "]"}], ";", 
      RowBox[{"inputX", "=", RowBox[{"x", " ", RowBox[{"gaussian", "[", "x", 
            "]"}]}]}], ";", RowBox[{"transformed", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{"sigma", " ", RowBox[{"(", RowBox[{"inputX", "/.", 
                  "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", RowBox[
                     {"mu", "+", RowBox[{"sigma", " ", "z"}]}]}]}], ")"}]}], 
            ",", "zAssumptions"}], "]"}]}], ";", 
      RowBox[{"primitiveZ", "=", RowBox[{"Integrate", "[", 
          RowBox[{"transformed", ",", "z", ",", RowBox[{"Assumptions", 
              "\[Rule]", "zAssumptions"}]}], "]"}]}], ";", 
      RowBox[{"raw", "=", RowBox[{"Association", "[", 
          RowBox[{"\"MomentX\"", "\[Rule]", RowBox[{"Collect", "[", 
              RowBox[{RowBox[{"Expand", "[", RowBox[{"FullSimplify", "[", 
                    RowBox[{RowBox[{"primitiveZ", "/.", "\[VeryThinSpace]", 
                        RowBox[{"z", "\[Rule]", FractionBox[RowBox[{"x", "-", 
                          "mu"}], "sigma"]}]}], ",", "assumptions"}], "]"}], 
                  "]"}], ",", "_Erf", ",", "Factor"}], "]"}]}], "]"}]}], ";", 
      "raw"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"MomentX\"", "\[Rule]", 
        RowBox[{RowBox[{RowBox[{"-", SuperscriptBox["\[ExponentialE]", RowBox[
                {"-", FractionBox[SuperscriptBox[RowBox[{"(", RowBox[
                      {"mu", "-", "x"}], ")"}], "2"], RowBox[{"2", " ", 
                    SuperscriptBox["sigma", "2"]}]]}]]}], " ", "h", " ", 
            SuperscriptBox["sigma", "2"]}], "+", RowBox[{"h", " ", "mu", " ", 
            SqrtBox[FractionBox["\[Pi]", "2"]], " ", "sigma", " ", 
            RowBox[{"Erf", "[", FractionBox[RowBox[{RowBox[{"-", "mu"}], "+", 
                 "x"}], RowBox[{SqrtBox["2"], " ", "sigma"}]], "]"}]}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"short", "=", RowBox[{"toShorthand", "[", 
          "primitiveZ", "]"}]}], ";", RowBox[{"parts", "=", 
        RowBox[{"KeySelect", "[", RowBox[{"partDefinitions", ",", 
            RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"short", ",", 
                    "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", "parts"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{RowBox[{"g", "[", "x", "]"}], "\[Rule]", 
          SuperscriptBox["\[ExponentialE]", RowBox[
            {"-", FractionBox[SuperscriptBox[RowBox[{"(", RowBox[
                  {RowBox[{"-", "mu"}], "+", "x"}], ")"}], "2"], 
              RowBox[{"2", " ", SuperscriptBox["sigma", "2"]}]]}]]}], ",", 
        RowBox[{RowBox[{"e", "[", "x", "]"}], "\[Rule]", 
          RowBox[{"Erf", "[", FractionBox[RowBox[{RowBox[{"-", "mu"}], "+", 
               "x"}], RowBox[{SqrtBox["2"], " ", "sigma"}]], "]"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Compute the compact definite moment", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"formula", "=", 
        RowBox[{"Association", "[", RowBox[{"\"MomentX\"", "\[Rule]", 
            RowBox[{"Factor", "[", RowBox[{RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x1"}]}], ")"}], "-", RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x0"}]}], ")"}]}], "]"}]}], "]"}]}], ";", "formula"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"MomentX\"", "\[Rule]", RowBox[{FractionBox["1", "2"], " ", 
          "h", " ", "sigma", " ", RowBox[{"(", RowBox[
             {RowBox[{RowBox[{"-", "mu"}], " ", SqrtBox[RowBox[{"2", " ", 
                   "\[Pi]"}]], " ", RowBox[{"e", "[", "x0", "]"}]}], "+", 
              RowBox[{"mu", " ", SqrtBox[RowBox[{"2", " ", "\[Pi]"}]], " ", 
                RowBox[{"e", "[", "x1", "]"}]}], "+", RowBox[{"2", " ", 
                "sigma", " ", RowBox[{"g", "[", "x0", "]"}]}], "-", 
              RowBox[{"2", " ", "sigma", " ", RowBox[{"g", "[", "x1", 
                  "]"}]}]}], ")"}]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], Cell["MomentY", "Section"], 
  Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "primitiveZ", ",", "raw", 
          ",", "short", ",", "parts", ",", "formula", ",", "g", ",", "e", 
          ",", "e2", ",", "e3"}], "]"}], ";", 
      RowBox[{"inputX", "=", FractionBox[SuperscriptBox[
          RowBox[{"gaussian", "[", "x", "]"}], "2"], "2"]}], ";", 
      RowBox[{"transformed", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"sigma", " ", RowBox[{"(", RowBox[{"inputX", "/.", 
                  "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", RowBox[
                     {"mu", "+", RowBox[{"sigma", " ", "z"}]}]}]}], ")"}]}], 
            ",", "zAssumptions"}], "]"}]}], ";", 
      RowBox[{"primitiveZ", "=", RowBox[{"Integrate", "[", 
          RowBox[{"transformed", ",", "z", ",", RowBox[{"Assumptions", 
              "\[Rule]", "zAssumptions"}]}], "]"}]}], ";", 
      RowBox[{"raw", "=", RowBox[{"Association", "[", 
          RowBox[{"\"MomentY\"", "\[Rule]", RowBox[{"Collect", "[", 
              RowBox[{RowBox[{"Expand", "[", RowBox[{"FullSimplify", "[", 
                    RowBox[{RowBox[{"primitiveZ", "/.", "\[VeryThinSpace]", 
                        RowBox[{"z", "\[Rule]", FractionBox[RowBox[{"x", "-", 
                          "mu"}], "sigma"]}]}], ",", "assumptions"}], "]"}], 
                  "]"}], ",", "_Erf", ",", "Factor"}], "]"}]}], "]"}]}], ";", 
      "raw"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"MomentY\"", "\[Rule]", RowBox[{FractionBox["1", "4"], " ", 
          SuperscriptBox["h", "2"], " ", SqrtBox["\[Pi]"], " ", "sigma", " ", 
          RowBox[{"Erf", "[", FractionBox[RowBox[{RowBox[{"-", "mu"}], "+", 
               "x"}], "sigma"], "]"}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
