                     "]"}]}], "-", SuperscriptBox[RowBox[{"s", "[", "x0", 
                    "]"}], "2"], "-", RowBox[{"4", " ", RowBox[{"s", "[", 
                     "x1", "]"}]}], "+", SuperscriptBox[RowBox[{"s", "[", 
                    "x1", "]"}], "2"]}], ")"}]}], 
           RowBox[{"6", " ", "a"}]]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"]}, WindowTitle -> "Logistic membership function", 
