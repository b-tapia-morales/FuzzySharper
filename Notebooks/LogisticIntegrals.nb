Notebook[{Cell["Logistic membership function", "Title"], 
  Cell["a = steepness A; c = center C; h = UMax. First derive the endpoints \
using positive steepness k, then substitute k = Abs[a]. Every moment calls \
Integrate before introducing its parts and computing F(x1)-F(x0). The \
substitution t = Exp[a*(x-c)] keeps the integration variable positive. s(x) \
is the complement of the normalized sigmoid. Evaluate from top to bottom.", 
   "Text"], Cell["Setup", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"a", ",", "c", ",", "h", ",", "x", ",", "t", ",", "x0", ",", 
          "x1", ",", "logistic", ",", "assumptions", ",", "tAssumptions", 
          ",", "splitConstant", ",", "toShorthand", ",", "partDefinitions", 
          ",", "inputX", ",", "transformed", ",", "coefficient", ",", 
          "unitInput", ",", "primitiveT", ",", "raw", ",", "short", ",", 
          "parts", ",", "formula", ",", "s", ",", "l", ",", "p", ",", "r"}], 
        "]"}], ";", RowBox[{RowBox[{"logistic", "[", "z_", "]"}], ":=", 
        FractionBox["h", RowBox[{"1", "+", RowBox[{"Exp", "[", 
             RowBox[{RowBox[{"-", "a"}], " ", RowBox[{"(", RowBox[{"z", "-", 
                   "c"}], ")"}]}], "]"}]}]]}], ";", 
      RowBox[{"assumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"a", ",", "c", ",", "h", ",", "x", 
                ",", "x0", ",", "x1"}], "}"}], "\[Element]", 
            TemplateBox[{}, "Reals"]}], "&&", RowBox[{"a", "\[NotEqual]", 
            "0"}], "&&", RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"x0", "<", "x1"}]}]}], ";", 
      RowBox[{"tAssumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"a", ",", "c", ",", "h", ",", "t"}], 
              "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
          RowBox[{"a", "\[NotEqual]", "0"}], "&&", 
          RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"t", ">", "0"}]}]}], ";", 
      RowBox[{RowBox[{"splitConstant", "[", RowBox[{"expression_", ",", 
            "variable_"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"factored", ",", "factors"}], "}"}], 
            ",", RowBox[{RowBox[{"factored", "=", RowBox[{"Factor", "[", 
                  "expression", "]"}]}], ";", RowBox[{"factors", "=", 
                RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Head", "[", 
                        "factored", "]"}], "===", "Times"}], ",", RowBox[
                     {"List", "@@", "factored"}], ",", RowBox[{"{", 
                      "factored", "}"}]}], "]"}]}], ";", RowBox[{"{", 
                RowBox[{RowBox[{"Times", "@@", RowBox[{"Select", "[", 
                      RowBox[{"factors", ",", RowBox[{RowBox[{"FreeQ", "[", 
                          RowBox[{"#1", ",", "variable"}], "]"}], "&"}]}], 
                      "]"}]}], ",", RowBox[{"Times", "@@", RowBox[{"Select", 
                      "[", RowBox[{"factors", ",", RowBox[{RowBox[{"!", 
                          RowBox[{"FreeQ", "[", RowBox[{"#1", ",", 
                          "variable"}], "]"}]}], "&"}]}], "]"}]}]}], 
                "}"}]}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"toShorthand", "[", "expression_", "]"}], ":=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{RowBox[{"expression", "/.", "\[VeryThinSpace]", 
                RowBox[{"{", RowBox[{RowBox[{RowBox[{"Log", "[", "t", "]"}], 
                      "\[Rule]", RowBox[{"a", " ", RowBox[{"(", RowBox[
                          {"x", "-", "c"}], ")"}]}]}], ",", RowBox[
                     {RowBox[{"Log", "[", RowBox[{"1", "+", "t"}], "]"}], 
                      "\[Rule]", RowBox[{"l", "[", "x", "]"}]}], ",", 
                    RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                          RowBox[{"-", "t"}]}], "]"}], "\[Rule]", RowBox[
                       {"p", "[", "x", "]"}]}], ",", RowBox[{RowBox[
                       {"PolyLog", "[", RowBox[{"3", ",", RowBox[{"-", 
                          "t"}]}], "]"}], "\[Rule]", RowBox[{"r", "[", "x", 
                        "]"}]}]}], "}"}]}], "/.", "\[VeryThinSpace]", 
              RowBox[{"t", "\[Rule]", RowBox[{FractionBox["1", RowBox[
                    {"s", "[", "x", "]"}]], "-", "1"}]}]}], ",", 
            "assumptions"}], "]"}]}], ";", RowBox[{"partDefinitions", "=", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{RowBox[{"s", "[", "x", "]"}], "\[Rule]", 
              FractionBox["1", RowBox[{"1", "+", RowBox[{"Exp", "[", 
                   RowBox[{"a", " ", RowBox[{"(", RowBox[{"x", "-", "c"}], 
                       ")"}]}], "]"}]}]]}], ",", RowBox[
             {RowBox[{"l", "[", "x", "]"}], "\[Rule]", RowBox[{"Log", "[", 
                RowBox[{"1", "+", RowBox[{"Exp", "[", RowBox[{"a", " ", 
                      RowBox[{"(", RowBox[{"x", "-", "c"}], ")"}]}], "]"}]}], 
                "]"}]}], ",", RowBox[{RowBox[{"p", "[", "x", "]"}], 
              "\[Rule]", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                  RowBox[{"-", RowBox[{"Exp", "[", RowBox[{"a", " ", 
                        RowBox[{"(", RowBox[{"x", "-", "c"}], ")"}]}], 
                      "]"}]}]}], "]"}]}], ",", RowBox[
             {RowBox[{"r", "[", "x", "]"}], "\[Rule]", RowBox[{"PolyLog", 
                "[", RowBox[{"3", ",", RowBox[{"-", RowBox[{"Exp", "[", 
                      RowBox[{"a", " ", RowBox[{"(", RowBox[{"x", "-", "c"}], 
                          ")"}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"Sigmoid\"", "\[Rule]", 
            RowBox[{"logistic", "[", "x", "]"}]}], ",", 
          RowBox[{"\"Assumptions\"", "\[Rule]", "assumptions"}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Sigmoid\"", "\[Rule]", FractionBox["h", 
           RowBox[{"1", "+", SuperscriptBox["\[ExponentialE]", 
              RowBox[{RowBox[{"-", "a"}], " ", RowBox[{"(", RowBox[
                   {RowBox[{"-", "c"}], "+", "x"}], ")"}]}]]}]]}], ",", 
        RowBox[{"\"Assumptions\"", "\[Rule]", 
          RowBox[{RowBox[{RowBox[{"(", RowBox[{"a", "|", "c", "|", "h", "|", 
                  "x", "|", "x0", "|", "x1"}], ")"}], "\[Element]", 
              TemplateBox[{}, "Reals"]}], "&&", RowBox[{"a", "\[NotEqual]", 
              "0"}], "&&", RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], 
            "&&", RowBox[{"x0", "<", "x1"}]}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], Cell["Sigmoid endpoints", "Section"], 
  Cell["1. Solve for the distance using positive steepness k", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"k", ",", "d", ",", "q", ",", "endpointAssumptions", ",", 
          "distanceSolution", ",", "distance", ",", "endpoints"}], "]"}], 
      ";", RowBox[{"endpointAssumptions", "=", 
        RowBox[{RowBox[{RowBox[{"{", RowBox[{"h", ",", "k", ",", "q", ",", 
                "d"}], "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
          RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"k", ">", "0"}], "&&", RowBox[{"0", "<", "q", "<", 
            FractionBox["1", "2"]}]}]}], ";", 
      RowBox[{"distanceSolution", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[
                   {FractionBox["h", RowBox[{"1", "+", RowBox[{"Exp", "[", 
                         RowBox[{RowBox[{"-", "k"}], " ", "d"}], "]"}]}]], 
                    "\[Equal]", RowBox[{"h", " ", RowBox[{"(", RowBox[
                         {"1", "-", "q"}], ")"}]}]}], "&&", RowBox[
                   {"d", ">", "0"}]}], ",", "d", ",", TemplateBox[{}, 
                 "Reals"], ",", RowBox[{"Assumptions", "\[Rule]", 
                  "endpointAssumptions"}]}], "]"}], ",", 
            "endpointAssumptions"}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
            TagBox[RowBox[{FractionBox["h", RowBox[{"1", "+", RowBox[
                   {"Exp", "[", RowBox[{RowBox[{"-", "k"}], " ", "d"}], 
                    "]"}]}]], "\[Equal]", RowBox[{"h", " ", RowBox[
                  {"(", RowBox[{"1", "-", "q"}], ")"}]}]}], HoldForm]}], ",", 
          RowBox[{"\"Distance solutions\"", "\[Rule]", 
            "distanceSolution"}]}], "]"}]}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
          TagBox[RowBox[{FractionBox["h", RowBox[{"1", "+", RowBox[
                 {"Exp", "[", RowBox[{RowBox[{"-", "k"}], " ", "d"}], 
                  "]"}]}]], "\[Equal]", RowBox[{"h", " ", RowBox[
                {"(", RowBox[{"1", "-", "q"}], ")"}]}]}], HoldForm]}], ",", 
        RowBox[{"\"Distance solutions\"", "\[Rule]", 
          RowBox[{"{", RowBox[{"{", RowBox[{"d", "\[Rule]", FractionBox[
                 RowBox[{"Log", "[", RowBox[{RowBox[{"-", "1"}], "+", 
                     FractionBox["1", "q"]}], "]"}], "k"]}], "}"}], 
            "}"}]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], 
  Cell["2. Apply the distance on both sides of the center", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"distance", "=", 
        RowBox[{"d", "/.", "\[VeryThinSpace]", RowBox[{"First", "[", 
            "distanceSolution", "]"}]}]}], ";", 
      RowBox[{"endpoints", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[
                   {"c", "-", RowBox[{"(", RowBox[{"distance", "/.", 
                        "\[VeryThinSpace]", RowBox[{"k", "\[Rule]", RowBox[
                          {"Abs", "[", "a", "]"}]}]}], ")"}]}]}], ",", 
                RowBox[{"x1", "\[Rule]", RowBox[{"c", "+", RowBox[{"(", 
                      RowBox[{"distance", "/.", "\[VeryThinSpace]", RowBox[
                         {"k", "\[Rule]", RowBox[{"Abs", "[", "a", "]"}]}]}], 
                      ")"}]}]}]}], "}"}], ",", RowBox[{"assumptions", "&&", 
              RowBox[{"q", "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
              RowBox[{"0", "<", "q", "<", FractionBox["1", "2"]}]}]}], 
          "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", "distance"}], 
          ",", RowBox[{"\"Endpoints\"", "\[Rule]", "endpoints"}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", 
          FractionBox[RowBox[{"Log", "[", RowBox[{RowBox[{"-", "1"}], "+", 
               FractionBox["1", "q"]}], "]"}], "k"]}], ",", 
        RowBox[{"\"Endpoints\"", "\[Rule]", RowBox[
           {"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"c", "-", 
                  FractionBox[RowBox[{"Log", "[", RowBox[{RowBox[{"-", "1"}], 
                       "+", FractionBox["1", "q"]}], "]"}], RowBox[{"Abs", 
                     "[", "a", "]"}]]}]}], ",", RowBox[{"x1", "\[Rule]", 
                RowBox[{"c", "+", FractionBox[RowBox[{"Log", "[", RowBox[
                      {RowBox[{"-", "1"}], "+", FractionBox["1", "q"]}], 
                     "]"}], RowBox[{"Abs", "[", "a", "]"}]]}]}]}], "}"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Evaluate the membership at each endpoint", "Text"], 
  Cell[BoxData[RowBox[{"Association", "[", 
      RowBox[{RowBox[{"\"Increasing: {left, right}\"", "\[Rule]", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"{", 
                  RowBox[{RowBox[{"logistic", "[", "x0", "]"}], ",", 
                    RowBox[{"logistic", "[", "x1", "]"}]}], "}"}], "/.", 
                "\[VeryThinSpace]", "endpoints"}], ",", RowBox[{
                "assumptions", "&&", RowBox[{"q", "\[Element]", TemplateBox[
                   {}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                  FractionBox["1", "2"]}], "&&", RowBox[{"a", ">", "0"}]}]}], 
            "]"}]}], ",", RowBox[{"\"Decreasing: {left, right}\"", "\[Rule]", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"{", 
                  RowBox[{RowBox[{"logistic", "[", "x0", "]"}], ",", 
                    RowBox[{"logistic", "[", "x1", "]"}]}], "}"}], "/.", 
                "\[VeryThinSpace]", "endpoints"}], ",", RowBox[{
                "assumptions", "&&", RowBox[{"q", "\[Element]", TemplateBox[
                   {}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                  FractionBox["1", "2"]}], "&&", RowBox[{"a", "<", "0"}]}]}], 
            "]"}]}]}], "]"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Increasing: {left, right}\"", "\[Rule]", 
          RowBox[{"{", RowBox[{RowBox[{"h", " ", "q"}], ",", RowBox[{"h", 
                "-", RowBox[{"h", " ", "q"}]}]}], "}"}]}], ",", 
        RowBox[{"\"Decreasing: {left, right}\"", "\[Rule]", 
          RowBox[{"{", RowBox[{RowBox[{"h", "-", RowBox[{"h", " ", "q"}]}], 
              ",", RowBox[{"h", " ", "q"}]}], "}"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["Area", "Section"], Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "coefficient", ",", 
          "unitInput", ",", "primitiveT", ",", "raw", ",", "short", ",", 
          "parts", ",", "formula", ",", "s", ",", "l", ",", "p", ",", "r"}], 
        "]"}], ";", RowBox[{"inputX", "=", RowBox[{"logistic", "[", "x", 
          "]"}]}], ";", RowBox[{"transformed", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {FractionBox[RowBox[{"inputX", "/.", "\[VeryThinSpace]", RowBox[
                {"x", "\[Rule]", RowBox[{"c", "+", FractionBox[RowBox[
                     {"Log", "[", "t", "]"}], "a"]}]}]}], 
             RowBox[{"a", " ", "t"}]], ",", "tAssumptions"}], "]"}]}], ";", 
      RowBox[{RowBox[{"{", RowBox[{"coefficient", ",", "unitInput"}], "}"}], 
        "=", RowBox[{"splitConstant", "[", RowBox[{"transformed", ",", "t"}], 
          "]"}]}], ";", RowBox[{"primitiveT", "=", 
        RowBox[{"coefficient", " ", RowBox[{"Integrate", "[", 
            RowBox[{"unitInput", ",", "t", ",", RowBox[{"Assumptions", 
                "\[Rule]", "tAssumptions"}]}], "]"}]}]}], ";", 
      RowBox[{"raw", "=", RowBox[{"Association", "[", 
          RowBox[{"\"Area\"", "\[Rule]", RowBox[{"Collect", "[", 
              RowBox[{RowBox[{"Expand", "[", RowBox[{"FullSimplify", "[", 
                    RowBox[{RowBox[{"primitiveT", "/.", "\[VeryThinSpace]", 
                        RowBox[{"t", "\[Rule]", RowBox[{"Exp", "[", RowBox[
                          {"a", " ", RowBox[{"(", RowBox[{"x", "-", "c"}], 
                          ")"}]}], "]"}]}]}], ",", "assumptions"}], "]"}], 
                  "]"}], ",", RowBox[{"{", RowBox[{"_Log", ",", "_PolyLog"}], 
                  "}"}], ",", "Factor"}], "]"}]}], "]"}]}], ";", "raw"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", FractionBox[
         RowBox[{"h", " ", RowBox[{"Log", "[", RowBox[{"1", "+", 
               SuperscriptBox["\[ExponentialE]", RowBox[{"a", " ", 
                  RowBox[{"(", RowBox[{RowBox[{"-", "c"}], "+", "x"}], 
                    ")"}]}]]}], "]"}]}], "a"]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"short", "=", RowBox[{"toShorthand", "[", 
          "primitiveT", "]"}]}], ";", RowBox[{"parts", "=", 
        RowBox[{"KeySelect", "[", RowBox[{"partDefinitions", ",", 
            RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"short", ",", 
                    "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", "parts"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"l", "[", "x", "]"}], "\[Rule]", 
        RowBox[{"Log", "[", RowBox[{"1", "+", SuperscriptBox[
             "\[ExponentialE]", RowBox[{"a", " ", RowBox[{"(", RowBox[
                  {RowBox[{"-", "c"}], "+", "x"}], ")"}]}]]}], "]"}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Compute the compact definite moment", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"formula", "=", 
        RowBox[{"Association", "[", RowBox[{"\"Area\"", "\[Rule]", 
            RowBox[{"Factor", "[", RowBox[{RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x1"}]}], ")"}], "-", RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x0"}]}], ")"}]}], "]"}]}], "]"}]}], ";", "formula"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", RowBox[{"-", FractionBox[
           RowBox[{"h", " ", RowBox[{"(", RowBox[{RowBox[{"l", "[", "x0", 
                   "]"}], "-", RowBox[{"l", "[", "x1", "]"}]}], ")"}]}], 
           "a"]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], Cell["MomentX", "Section"], 
  Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "coefficient", ",", 
          "unitInput", ",", "primitiveT", ",", "raw", ",", "short", ",", 
          "parts", ",", "formula", ",", "s", ",", "l", ",", "p", ",", "r"}], 
        "]"}], ";", RowBox[{"inputX", "=", 
        RowBox[{"x", " ", RowBox[{"logistic", "[", "x", "]"}]}]}], ";", 
      RowBox[{"transformed", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{FractionBox[RowBox[{"inputX", "/.", "\[VeryThinSpace]", 
               RowBox[{"x", "\[Rule]", RowBox[{"c", "+", FractionBox[
                    RowBox[{"Log", "[", "t", "]"}], "a"]}]}]}], 
             RowBox[{"a", " ", "t"}]], ",", "tAssumptions"}], "]"}]}], ";", 
      RowBox[{RowBox[{"{", RowBox[{"coefficient", ",", "unitInput"}], "}"}], 
        "=", RowBox[{"splitConstant", "[", RowBox[{"transformed", ",", "t"}], 
          "]"}]}], ";", RowBox[{"primitiveT", "=", 
        RowBox[{"coefficient", " ", RowBox[{"Integrate", "[", 
            RowBox[{"unitInput", ",", "t", ",", RowBox[{"Assumptions", 
                "\[Rule]", "tAssumptions"}]}], "]"}]}]}], ";", 
      RowBox[{"raw", "=", RowBox[{"Association", "[", 
          RowBox[{"\"MomentX\"", "\[Rule]", RowBox[{"Collect", "[", 
              RowBox[{RowBox[{"Expand", "[", RowBox[{"FullSimplify", "[", 
                    RowBox[{RowBox[{"primitiveT", "/.", "\[VeryThinSpace]", 
                        RowBox[{"t", "\[Rule]", RowBox[{"Exp", "[", RowBox[
                          {"a", " ", RowBox[{"(", RowBox[{"x", "-", "c"}], 
                          ")"}]}], "]"}]}]}], ",", "assumptions"}], "]"}], 
                  "]"}], ",", RowBox[{"{", RowBox[{"_Log", ",", "_PolyLog"}], 
                  "}"}], ",", "Factor"}], "]"}]}], "]"}]}], ";", "raw"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"MomentX\"", "\[Rule]", 
        RowBox[{FractionBox[RowBox[{"h", " ", "x", " ", 
             RowBox[{"Log", "[", RowBox[{"1", "+", SuperscriptBox[
                  "\[ExponentialE]", RowBox[{"a", " ", RowBox[{"(", 
                      RowBox[{RowBox[{"-", "c"}], "+", "x"}], ")"}]}]]}], 
               "]"}]}], "a"], "+", FractionBox[RowBox[{"h", " ", 
             RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[{"-", 
                   SuperscriptBox["\[ExponentialE]", RowBox[{"a", " ", 
                      RowBox[{"(", RowBox[{RowBox[{"-", "c"}], "+", "x"}], 
                        ")"}]}]]}]}], "]"}]}], SuperscriptBox["a", "2"]]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"short", "=", RowBox[{"toShorthand", "[", 
          "primitiveT", "]"}]}], ";", RowBox[{"parts", "=", 
        RowBox[{"KeySelect", "[", RowBox[{"partDefinitions", ",", 
            RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"short", ",", 
                    "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", "parts"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{RowBox[{"l", "[", "x", "]"}], "\[Rule]", 
          RowBox[{"Log", "[", RowBox[{"1", "+", SuperscriptBox[
               "\[ExponentialE]", RowBox[{"a", " ", RowBox[{"(", RowBox[
                    {RowBox[{"-", "c"}], "+", "x"}], ")"}]}]]}], "]"}]}], 
        ",", RowBox[{RowBox[{"p", "[", "x", "]"}], "\[Rule]", 
          RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[{"-", 
                SuperscriptBox["\[ExponentialE]", RowBox[{"a", " ", 
                   RowBox[{"(", RowBox[{RowBox[{"-", "c"}], "+", "x"}], 
                     ")"}]}]]}]}], "]"}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], 
  Cell["3. Compute the compact definite moment", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"formula", "=", 
        RowBox[{"Association", "[", RowBox[{"\"MomentX\"", "\[Rule]", 
            RowBox[{"Factor", "[", RowBox[{RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x1"}]}], ")"}], "-", RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x0"}]}], ")"}]}], "]"}]}], "]"}]}], ";", "formula"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"MomentX\"", "\[Rule]", 
        RowBox[{"-", FractionBox[RowBox[{"h", " ", RowBox[{"(", RowBox[
                {RowBox[{"a", " ", "x0", " ", RowBox[{"l", "[", "x0", 
                     "]"}]}], "-", RowBox[{"a", " ", "x1", " ", RowBox[
                    {"l", "[", "x1", "]"}]}], "+", RowBox[{"p", "[", "x0", 
                   "]"}], "-", RowBox[{"p", "[", "x1", "]"}]}], ")"}]}], 
           SuperscriptBox["a", "2"]]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], Cell["MomentY", "Section"], 
  Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "coefficient", ",", 
          "unitInput", ",", "primitiveT", ",", "raw", ",", "short", ",", 
