Notebook[{Cell["Generalized bell membership function", "Title"], 
  Cell["a = Abs[A] is the positive width; b = B > 0; c = C; h = UMax. q is \
the tail membership as a fraction of h. Derive the support endpoints first. \
Each moment then shows (1) the antiderivative obtained by Integrate, (2) its \
parts, and (3) the definite moment F(x1)-F(x0). Evaluate from top to bottom."\
, "Text"], Cell["On the right, t = (x-c)/a > 0 and dx = a dt. Integrate the \
terms separately after removing their constant factors. The radial \
denominator is even, so extending each primitive across the center keeps its \
signed polynomial powers and uses Abs[(x-c)/a]^(2 b) in the hypergeometric \
argument. This also handles non-integer b without complex powers of a \
negative number.", "Text"], Cell["All bounds used for the moments are finite; \
no whole-line convergence condition is required. For an absolute cutoff \
alpha, use q = alpha/h with 0 < alpha < h. If alpha = h the two endpoints \
coincide at c; if alpha > h there is no endpoint. The library cutoff is an \
absolute membership value, 2 * DefaultTolerance = 1/5000. Its current \
alpha-cut implementation omits the height normalization; this notebook \
derives the height-aware distance.", "Text"], Cell["Setup", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "h", ",", "x", ",", "t", ",", 
          "x0", ",", "x1", ",", "bell", ",", "assumptions", ",", 
          "tAssumptions", ",", "splitConstant", ",", "toX", ",", "inputX", 
          ",", "transformed", ",", "terms", ",", "coefficients", ",", 
          "integrands", ",", "primitiveT", ",", "raw", ",", "kernels", ",", 
          "names", ",", "partDefinitions", ",", "short", ",", "parts", ",", 
          "formula", ",", "u", ",", "p", ",", "r", ",", "s"}], "]"}], ";", 
      RowBox[{RowBox[{"bell", "[", "z_", "]"}], ":=", FractionBox["h", 
         RowBox[{"1", "+", SuperscriptBox[RowBox[{"Abs", "[", 
              FractionBox[RowBox[{"z", "-", "c"}], "a"], "]"}], 
            RowBox[{"2", " ", "b"}]]}]]}], ";", 
      RowBox[{"assumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "c", ",", "h", 
                ",", "x", ",", "x0", ",", "x1"}], "}"}], "\[Element]", 
            TemplateBox[{}, "Reals"]}], "&&", RowBox[{"a", ">", "0"}], "&&", 
          RowBox[{"b", ">", "0"}], "&&", RowBox[{"0", "<", "h", 
            "\[LessEqual]", "1"}], "&&", RowBox[{"x0", "<", "x1"}]}]}], ";", 
      RowBox[{"tAssumptions", "=", RowBox[
         {RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "c", ",", "h", 
                ",", "t"}], "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], 
          "&&", RowBox[{"a", ">", "0"}], "&&", RowBox[{"b", ">", "0"}], "&&", 
          RowBox[{"0", "<", "h", "\[LessEqual]", "1"}], "&&", 
          RowBox[{"t", ">", "0"}]}]}], ";", 
      RowBox[{RowBox[{"splitConstant", "[", RowBox[{"expression_", ",", 
            "variable_"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"factored", ",", "factors"}], "}"}], 
            ",", RowBox[{RowBox[{"factored", "=", RowBox[{"Factor", "[", 
                  "expression", "]"}]}], ";", RowBox[{"factors", "=", 
                RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Head", "[", 
                        "factored", "]"}], "===", "Times"}], ",", RowBox[
                     {"List", "@@", "factored"}], ",", RowBox[{"{", 
                      "factored", "}"}]}], "]"}]}], ";", RowBox[{"{", 
                RowBox[{RowBox[{"Times", "@@", RowBox[{"Select", "[", 
                      RowBox[{"factors", ",", RowBox[{RowBox[{"FreeQ", "[", 
                          RowBox[{"#1", ",", "variable"}], "]"}], "&"}]}], 
                      "]"}]}], ",", RowBox[{"Times", "@@", RowBox[{"Select", 
                      "[", RowBox[{"factors", ",", RowBox[{RowBox[{"!", 
                          RowBox[{"FreeQ", "[", RowBox[{"#1", ",", 
                          "variable"}], "]"}]}], "&"}]}], "]"}]}]}], 
                "}"}]}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"toX", "[", "expression_", "]"}], ":=", 
        RowBox[{RowBox[{"expression", "/.", "\[VeryThinSpace]", 
            RowBox[{SuperscriptBox["t", RowBox[{"2", " ", "b"}]], "\[Rule]", 
              SuperscriptBox[RowBox[{"Abs", "[", FractionBox[RowBox[
                   {"x", "-", "c"}], "a"], "]"}], RowBox[{"2", " ", 
                 "b"}]]}]}], "/.", "\[VeryThinSpace]", 
          RowBox[{"t", "\[Rule]", FractionBox[RowBox[{"x", "-", "c"}], 
             "a"]}]}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"Generalized bell\"", "\[Rule]", 
            RowBox[{"bell", "[", "x", "]"}]}], ",", 
          RowBox[{"\"Assumptions\"", "\[Rule]", "assumptions"}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Generalized bell\"", "\[Rule]", 
          FractionBox["h", RowBox[{"1", "+", SuperscriptBox[RowBox[{"Abs", 
                "[", FractionBox[RowBox[{RowBox[{"-", "c"}], "+", "x"}], 
                 "a"], "]"}], RowBox[{"2", " ", "b"}]]}]]}], ",", 
        RowBox[{"\"Assumptions\"", "\[Rule]", 
          RowBox[{RowBox[{RowBox[{"(", RowBox[{"a", "|", "b", "|", "c", "|", 
                  "h", "|", "x", "|", "x0", "|", "x1"}], ")"}], "\[Element]", 
              TemplateBox[{}, "Reals"]}], "&&", RowBox[{"a", ">", "0"}], 
            "&&", RowBox[{"b", ">", "0"}], "&&", RowBox[{"0", "<", "h", 
              "\[LessEqual]", "1"}], "&&", RowBox[{"x0", "<", "x1"}]}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["Generalized bell endpoints", "Section"], 
  Cell["1. Solve for the distance from the center", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"d", ",", "q", ",", "alpha", ",", "endpointAssumptions", ",", 
          "distanceSolution", ",", "distance", ",", "endpoints", ",", 
          "absoluteTailSolution", ",", "absoluteDistance", ",", 
          "absoluteEndpoints", ",", "cutoff"}], "]"}], ";", 
      RowBox[{"endpointAssumptions", "=", 
        RowBox[{RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "h", ",", 
                "d", ",", "q"}], "}"}], "\[Element]", TemplateBox[{}, 
             "Reals"]}], "&&", RowBox[{"a", ">", "0"}], "&&", 
          RowBox[{"b", ">", "0"}], "&&", RowBox[{"0", "<", "h", 
            "\[LessEqual]", "1"}], "&&", RowBox[{"0", "<", "q", "<", 
            "1"}]}]}], ";", RowBox[{"distanceSolution", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{FractionBox["h", 
                     RowBox[{"1", "+", SuperscriptBox[RowBox[{"(", 
                          FractionBox["d", "a"], ")"}], RowBox[{"2", " ", 
                          "b"}]]}]], "\[Equal]", RowBox[{"h", " ", "q"}]}], 
                  "&&", RowBox[{"d", ">", "0"}]}], ",", "d", ",", 
                TemplateBox[{}, "Reals"], ",", RowBox[{"Assumptions", 
                  "\[Rule]", "endpointAssumptions"}]}], "]"}], ",", 
            "endpointAssumptions"}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
            TagBox[RowBox[{FractionBox["h", RowBox[{"1", "+", SuperscriptBox[
                   RowBox[{"(", FractionBox["d", "a"], ")"}], RowBox[
                    {"2", " ", "b"}]]}]], "\[Equal]", RowBox[{"h", " ", 
                 "q"}]}], HoldForm]}], ",", RowBox[{"\"Distance solutions\"", 
            "\[Rule]", "distanceSolution"}]}], "]"}]}]], "Input", 
   CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Equation\"", "\[Rule]", 
          TagBox[RowBox[{FractionBox["h", RowBox[{"1", "+", SuperscriptBox[
                 RowBox[{"(", FractionBox["d", "a"], ")"}], RowBox[
                  {"2", " ", "b"}]]}]], "\[Equal]", RowBox[{"h", " ", 
               "q"}]}], HoldForm]}], ",", RowBox[{"\"Distance solutions\"", 
          "\[Rule]", RowBox[{"{", RowBox[{"{", RowBox[{"d", "\[Rule]", 
                RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                      {RowBox[{"-", "1"}], "+", FractionBox["1", "q"]}], 
                     ")"}], RowBox[{FractionBox["1", "2"], "/", "b"}]]}]}], 
              "}"}], "}"}]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], 
  Cell["2. Apply the distance on both sides of the center", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"distance", "=", 
        RowBox[{"d", "/.", "\[VeryThinSpace]", RowBox[{"First", "[", 
            "distanceSolution", "]"}]}]}], ";", 
      RowBox[{"endpoints", "=", RowBox[{"FullSimplify", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[
                   {"c", "-", "distance"}]}], ",", RowBox[{"x1", "\[Rule]", 
                  RowBox[{"c", "+", "distance"}]}]}], "}"}], ",", 
            RowBox[{"assumptions", "&&", RowBox[{"q", "\[Element]", 
                TemplateBox[{}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                "1"}]}]}], "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", "distance"}], 
          ",", RowBox[{"\"Endpoints\"", "\[Rule]", "endpoints"}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Distance from center\"", "\[Rule]", 
          RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                {RowBox[{"-", "1"}], "+", FractionBox["1", "q"]}], ")"}], 
             RowBox[{FractionBox["1", "2"], "/", "b"}]]}]}], ",", 
        RowBox[{"\"Endpoints\"", "\[Rule]", RowBox[
           {"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"c", "-", 
                  RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                        {RowBox[{"-", "1"}], "+", FractionBox["1", "q"]}], 
                       ")"}], RowBox[{FractionBox["1", "2"], "/", 
                       "b"}]]}]}]}], ",", RowBox[{"x1", "\[Rule]", 
                RowBox[{"c", "+", RowBox[{"a", " ", SuperscriptBox[RowBox[
                      {"(", RowBox[{RowBox[{"-", "1"}], "+", FractionBox["1", 
                          "q"]}], ")"}], RowBox[{FractionBox["1", "2"], "/", 
                       "b"}]]}]}]}]}], "}"}]}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], 
  Cell["3. Evaluate the membership at each endpoint", "Text"], 
  Cell[BoxData[RowBox[{"Association", "[", 
      RowBox[{"\"Memberships {left, right}\"", "\[Rule]", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{RowBox[{"{", RowBox[{RowBox[{"bell", "[", "x0", "]"}], 
                  ",", RowBox[{"bell", "[", "x1", "]"}]}], "}"}], "/.", 
              "\[VeryThinSpace]", "endpoints"}], ",", 
            RowBox[{"assumptions", "&&", RowBox[{"q", "\[Element]", 
                TemplateBox[{}, "Reals"]}], "&&", RowBox[{"0", "<", "q", "<", 
                "1"}]}]}], "]"}]}], "]"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Memberships {left, right}\"", "\[Rule]", 
        RowBox[{"{", RowBox[{RowBox[{"h", " ", "q"}], ",", 
            RowBox[{"h", " ", "q"}]}], "}"}]}], "\[RightAssociation]"}]], 
   "Output", CellLabel -> "Out:"], 
  Cell["4. Convert an absolute membership cutoff to a fraction", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"absoluteTailSolution", "=", 
        RowBox[{"FullSimplify", "[", RowBox[
           {RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{"h", " ", "q"}], 
                  "\[Equal]", "alpha"}], ",", "q", ",", TemplateBox[{}, 
                 "Reals"], ",", RowBox[{"Assumptions", "\[Rule]", 
                  RowBox[{RowBox[{RowBox[{"{", RowBox[{"h", ",", "alpha"}], 
                        "}"}], "\[Element]", TemplateBox[{}, "Reals"]}], 
                    "&&", RowBox[{"0", "<", "alpha", "<", "h", 
                      "\[LessEqual]", "1"}]}]}]}], "]"}], ",", 
            RowBox[{RowBox[{RowBox[{"{", RowBox[{"h", ",", "alpha"}], "}"}], 
                "\[Element]", TemplateBox[{}, "Reals"]}], "&&", 
              RowBox[{"0", "<", "alpha", "<", "h", "\[LessEqual]", "1"}]}]}], 
          "]"}]}], ";", RowBox[{"absoluteDistance", "=", 
        RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"distance", "/.", 
              "\[VeryThinSpace]", RowBox[{"First", "[", 
                "absoluteTailSolution", "]"}]}], ",", 
            RowBox[{"assumptions", "&&", RowBox[{"alpha", "\[Element]", 
                TemplateBox[{}, "Reals"]}], "&&", RowBox[{"0", "<", "alpha", 
                "<", "h"}]}]}], "]"}]}], ";", 
      RowBox[{"absoluteEndpoints", "=", 
        RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"c", "-", 
                "absoluteDistance"}]}], ",", RowBox[{"x1", "\[Rule]", 
              RowBox[{"c", "+", "absoluteDistance"}]}]}], "}"}]}], ";", 
      RowBox[{"cutoff", "=", FractionBox["2", "10000"]}], ";", 
      RowBox[{"Association", "[", RowBox[
         {RowBox[{"\"Fraction for membership alpha\"", "\[Rule]", 
            "absoluteTailSolution"}], ",", RowBox[
           {"\"Distance for membership alpha\"", "\[Rule]", 
            "absoluteDistance"}], ",", RowBox[
           {"\"Endpoints for membership alpha\"", "\[Rule]", 
            "absoluteEndpoints"}], ",", RowBox[
           {"\"Library cutoff: 2 * DefaultTolerance\"", "\[Rule]", 
            "cutoff"}], ",", RowBox[
           {"\"Distance at that cutoff, for h > cutoff\"", "\[Rule]", 
            RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"absoluteDistance", 
                  "/.", "\[VeryThinSpace]", RowBox[{"alpha", "\[Rule]", 
                    "cutoff"}]}], ",", RowBox[{"assumptions", "&&", 
                  RowBox[{"h", ">", "cutoff"}]}]}], "]"}]}]}], "]"}]}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"Fraction for membership alpha\"", "\[Rule]", 
          RowBox[{"{", RowBox[{"{", RowBox[{"q", "\[Rule]", FractionBox[
                 "alpha", "h"]}], "}"}], "}"}]}], ",", 
        RowBox[{"\"Distance for membership alpha\"", "\[Rule]", 
          RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                {RowBox[{"-", "1"}], "+", FractionBox["h", "alpha"]}], ")"}], 
             RowBox[{FractionBox["1", "2"], "/", "b"}]]}]}], ",", 
        RowBox[{"\"Endpoints for membership alpha\"", "\[Rule]", 
          RowBox[{"{", RowBox[{RowBox[{"x0", "\[Rule]", RowBox[{"c", "-", 
                  RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                        {RowBox[{"-", "1"}], "+", FractionBox["h", 
                          "alpha"]}], ")"}], RowBox[{FractionBox["1", "2"], 
                       "/", "b"}]]}]}]}], ",", RowBox[{"x1", "\[Rule]", 
                RowBox[{"c", "+", RowBox[{"a", " ", SuperscriptBox[RowBox[
                      {"(", RowBox[{RowBox[{"-", "1"}], "+", FractionBox["h", 
                          "alpha"]}], ")"}], RowBox[{FractionBox["1", "2"], 
                       "/", "b"}]]}]}]}]}], "}"}]}], ",", 
        RowBox[{"\"Library cutoff: 2 * DefaultTolerance\"", "\[Rule]", 
          FractionBox["1", "5000"]}], ",", 
        RowBox[{"\"Distance at that cutoff, for h > cutoff\"", "\[Rule]", 
          RowBox[{"a", " ", SuperscriptBox[RowBox[{"(", RowBox[
                {RowBox[{"-", "1"}], "+", RowBox[{"5000", " ", "h"}]}], 
               ")"}], RowBox[{FractionBox["1", "2"], "/", "b"}]]}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["Area", "Section"], Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "terms", ",", 
          "coefficients", ",", "integrands", ",", "primitiveT", ",", "raw", 
          ",", "kernels", ",", "names", ",", "partDefinitions", ",", "short", 
          ",", "parts", ",", "formula", ",", "u", ",", "p", ",", "r", ",", 
          "s"}], "]"}], ";", RowBox[{"inputX", "=", 
        RowBox[{"bell", "[", "x", "]"}]}], ";", 
      RowBox[{"transformed", "=", RowBox[{"Expand", "[", 
          RowBox[{RowBox[{"a", " ", RowBox[{"(", RowBox[{"inputX", "/.", 
                  "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", RowBox[
                     {"c", "+", RowBox[{"a", " ", "t"}]}]}]}], ")"}]}], "/.", 
            "\[VeryThinSpace]", RowBox[{RowBox[{"Abs", "[", "t", "]"}], 
              "\[Rule]", "t"}]}], "]"}]}], ";", 
      RowBox[{"terms", "=", RowBox[{"If", "[", 
          RowBox[{RowBox[{RowBox[{"Head", "[", "transformed", "]"}], "===", 
              "Plus"}], ",", RowBox[{"List", "@@", "transformed"}], ",", 
            RowBox[{"{", "transformed", "}"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"{", RowBox[{"coefficients", ",", "integrands"}], 
          "}"}], "=", TemplateBox[
         {RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{RowBox[{"splitConstant", 
                    "[", RowBox[{"#1", ",", "t"}], "]"}], "&"}], ")"}], "/@", 
              "terms"}], ")"}]}, "Transpose", SyntaxForm -> 
          SuperscriptBox]}], ";", RowBox[{"primitiveT", "=", 
        RowBox[{"coefficients", ".", RowBox[
           {RowBox[{"(", RowBox[{RowBox[{"Integrate", "[", RowBox[{"#1", ",", 
                    "t", ",", RowBox[{"Assumptions", "\[Rule]", 
                      "tAssumptions"}]}], "]"}], "&"}], ")"}], "/@", 
            "integrands"}]}]}], ";", RowBox[{"raw", "=", 
        RowBox[{"Association", "[", RowBox[{"\"Area\"", "\[Rule]", 
            RowBox[{"Collect", "[", RowBox[{RowBox[{"Expand", "[", 
                  RowBox[{"toX", "[", "primitiveT", "]"}], "]"}], ",", 
                "_Hypergeometric2F1", ",", "Factor"}], "]"}]}], "]"}]}], ";", 
      "raw"}]], "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", RowBox[{RowBox[{"-", "h"}], " ", 
          RowBox[{"(", RowBox[{"c", "-", "x"}], ")"}], " ", 
          RowBox[{"Hypergeometric2F1", "[", RowBox[{"1", ",", 
              FractionBox["1", RowBox[{"2", " ", "b"}]], ",", 
              RowBox[{"1", "+", FractionBox["1", RowBox[{"2", " ", "b"}]]}], 
              ",", RowBox[{"-", SuperscriptBox[RowBox[{"Abs", "[", 
                   FractionBox[RowBox[{RowBox[{"-", "c"}], "+", "x"}], "a"], 
                   "]"}], RowBox[{"2", " ", "b"}]]}]}], "]"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["2. Define the parts used by the derived formula", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"kernels", "=", 
        RowBox[{"DeleteDuplicates", "[", RowBox[{"Cases", "[", 
            RowBox[{"primitiveT", ",", "_Hypergeometric2F1", ",", 
              "\[Infinity]"}], "]"}], "]"}]}], ";", 
      RowBox[{"names", "=", RowBox[{"Take", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"p", "[", "x", "]"}], ",", 
                RowBox[{"r", "[", "x", "]"}], ",", RowBox[{"s", "[", "x", 
                  "]"}]}], "}"}], ",", RowBox[{"Length", "[", "kernels", 
              "]"}]}], "]"}]}], ";", RowBox[{"partDefinitions", "=", 
        RowBox[{"Association", "[", RowBox[{"Join", "[", 
            RowBox[{RowBox[{"{", RowBox[{RowBox[{"u", "[", "x", "]"}], 
                  "\[Rule]", RowBox[{"x", "-", "c"}]}], "}"}], ",", 
              RowBox[{"Thread", "[", RowBox[{"names", "\[Rule]", 
                  RowBox[{"toX", "/@", "kernels"}]}], "]"}]}], "]"}], 
          "]"}]}], ";", RowBox[{"short", "=", 
        RowBox[{"Factor", "[", RowBox[{RowBox[{"primitiveT", "/.", 
              "\[VeryThinSpace]", RowBox[{"Thread", "[", RowBox[{"kernels", 
                  "\[Rule]", "names"}], "]"}]}], "/.", "\[VeryThinSpace]", 
            RowBox[{"t", "\[Rule]", FractionBox[RowBox[{"u", "[", "x", "]"}], 
               "a"]}]}], "]"}]}], ";", RowBox[{"parts", "=", 
        RowBox[{"KeySelect", "[", RowBox[{"partDefinitions", ",", 
            RowBox[{RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"short", ",", 
                    "#1"}], "]"}]}], "&"}]}], "]"}]}], ";", "parts"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{RowBox[{"u", "[", "x", "]"}], "\[Rule]", 
          RowBox[{RowBox[{"-", "c"}], "+", "x"}]}], ",", 
        RowBox[{RowBox[{"p", "[", "x", "]"}], "\[Rule]", 
          RowBox[{"Hypergeometric2F1", "[", RowBox[{"1", ",", 
              FractionBox["1", RowBox[{"2", " ", "b"}]], ",", 
              RowBox[{"1", "+", FractionBox["1", RowBox[{"2", " ", "b"}]]}], 
              ",", RowBox[{"-", SuperscriptBox[RowBox[{"Abs", "[", 
                   FractionBox[RowBox[{RowBox[{"-", "c"}], "+", "x"}], "a"], 
                   "]"}], RowBox[{"2", " ", "b"}]]}]}], "]"}]}]}], 
      "\[RightAssociation]"}]], "Output", CellLabel -> "Out:"], 
  Cell["3. Compute the compact definite moment", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"formula", "=", 
        RowBox[{"Association", "[", RowBox[{"\"Area\"", "\[Rule]", 
            RowBox[{"Factor", "[", RowBox[{RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x1"}]}], ")"}], "-", RowBox[{"(", RowBox[{"short", 
                    "/.", "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                      "x0"}]}], ")"}]}], "]"}]}], "]"}]}], ";", "formula"}]], 
   "Input", CellLabel -> "In:"], 
  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{"\"Area\"", "\[Rule]", RowBox[{RowBox[{"-", "h"}], " ", 
          RowBox[{"(", RowBox[{RowBox[{RowBox[{"p", "[", "x0", "]"}], " ", 
                RowBox[{"u", "[", "x0", "]"}]}], "-", RowBox[{RowBox[
                 {"p", "[", "x1", "]"}], " ", RowBox[{"u", "[", "x1", 
                  "]"}]}]}], ")"}]}]}], "\[RightAssociation]"}]], "Output", 
   CellLabel -> "Out:"], Cell["MomentX", "Section"], 
  Cell["1. Derive the antiderivative", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", 
        RowBox[{"inputX", ",", "transformed", ",", "terms", ",", 
          "coefficients", ",", "integrands", ",", "primitiveT", ",", "raw", 
          ",", "kernels", ",", "names", ",", "partDefinitions", ",", "short", 
          ",", "parts", ",", "formula", ",", "u", ",", "p", ",", "r", ",", 
          "s"}], "]"}], ";", RowBox[{"inputX", "=", 
        RowBox[{"x", " ", RowBox[{"bell", "[", "x", "]"}]}]}], ";", 
      RowBox[{"transformed", "=", RowBox[{"Expand", "[", 
          RowBox[{RowBox[{"a", " ", RowBox[{"(", RowBox[{"inputX", "/.", 
                  "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", RowBox[
                     {"c", "+", RowBox[{"a", " ", "t"}]}]}]}], ")"}]}], "/.", 
            "\[VeryThinSpace]", RowBox[{RowBox[{"Abs", "[", "t", "]"}], 
              "\[Rule]", "t"}]}], "]"}]}], ";", 
      RowBox[{"terms", "=", RowBox[{"If", "[", 
          RowBox[{RowBox[{RowBox[{"Head", "[", "transformed", "]"}], "===", 
